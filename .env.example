DATABASE_URL="postgresql://user:password@localhost:5432/fitretro"

# Random secret used to sign session cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET=""

# Anthropic API key used for LLM-assisted features (food suggestions, recipe creation).
# Get one at https://console.anthropic.com/ - not required for auth or basic tracking.
ANTHROPIC_API_KEY=""

# Set to "false" only if serving over plain HTTP with no TLS in front (e.g. a bare
# droplet IP with no domain/certificate yet). Leave unset once you have HTTPS -
# a Secure cookie is silently dropped by browsers over plain HTTP, which breaks logins.
# COOKIE_SECURE=false

# Email of the site owner's account. Gates owner-only pages (e.g. /wake-up) that shouldn't
# be visible to any other signed-up user, regardless of role.
OWNER_EMAIL=""

# Stripe billing — TEST MODE ONLY for now (the app refuses sk_live_/rk_live_ keys), and nothing
# is paywalled yet. Names only here: put real values in .env, which is gitignored.
# Keys: https://dashboard.stripe.com/test/apikeys
# Webhook: point an endpoint at <your-domain>/api/stripe/webhook listening for
# customer.subscription.created, .updated and .deleted — or locally run
# `stripe listen --forward-to localhost:3000/api/stripe/webhook`, which prints a signing secret.
#
# Server-only — never rename these with a NEXT_PUBLIC_ prefix.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price ID (price_...) of the monthly plan.
STRIPE_PRICE_ID=""
# Human-readable promotion code (not the coupon ID) the QR sticker promises, e.g. "FREEMONTH".
# Visitors arriving via /promo1 get it applied automatically at checkout; if it's unset,
# inactive or can't be retrieved, their checkout is stopped rather than sent at full price.
# For "$0 first month, then $8/month", its coupon should be 100% off with duration "once".
STRIPE_PROMO_CODE=""
# Publishable key (pk_test_...), browser-safe by design. Not read by any code yet: checkout
# redirects to Stripe-hosted Checkout, which doesn't need it. Reserved for client-side Stripe.js.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
