DATABASE_URL="postgresql://user:password@localhost:5432/fitretro"

# Random secret used to sign session cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET=""

# Anthropic API key used for LLM-assisted features (food suggestions, recipe creation).
# Get one at https://console.anthropic.com/ - not required for auth or basic tracking.
ANTHROPIC_API_KEY=""

# Set to "false" only if serving over plain HTTP with no TLS in front (e.g. a bare
# droplet IP with no domain/certificate yet). Leave unset once you have HTTPS -
# a Secure cookie is silently dropped by browsers over plain HTTP, which breaks logins.
# COOKIE_SECURE=false

# Email of the site owner's account. Gates owner-only pages (e.g. /wake-up) that shouldn't
# be visible to any other signed-up user, regardless of role.
OWNER_EMAIL=""

# Stripe billing (framework only for now — nothing in the app is paywalled yet). Use TEST
# mode keys (sk_test_.../whsec_test_...) until this is actually launched. Get the secret key
# and set up the webhook at https://dashboard.stripe.com/test/webhooks, forwarding to
# <your-domain>/api/stripe/webhook, listening for:
# customer.subscription.created, customer.subscription.updated, customer.subscription.deleted.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# The Price ID (price_...) for the single monthly subscription plan, from the Stripe Dashboard.
STRIPE_PRICE_ID=""
# The human-readable Promotion Code (not the coupon ID) tied to the "free month" QR sticker,
# e.g. "FREEMONTH" — created under Product catalog > Coupons > Promotion codes in Stripe.
STRIPE_PROMO_CODE=""
